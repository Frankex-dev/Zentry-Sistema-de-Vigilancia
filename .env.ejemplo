# Copia este archivo como .env (en la misma carpeta) y llena los valores.
# El .env tiene claves: NO se sube a GitHub (está en .gitignore).
# Sin .env, Zentry usa la base SQLite local (Zentry/db.sqlite3).

# Base de datos en Amazon RDS (PostgreSQL)
ZENTRY_DB_ENGINE=postgresql
ZENTRY_DB_HOST=zentry-db.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
ZENTRY_DB_PORT=5432
ZENTRY_DB_NAME=zentry
ZENTRY_DB_SSLMODE=require
# El usuario y la contraseña NO van aquí: Zentry se los pide a AWS Secrets Manager.
# Hace falta una sesión de AWS en la PC (aws login) o un rol en el servidor.
ZENTRY_DB_SECRETO=arn:aws:secretsmanager:us-east-1:XXXXXXXXXXXX:secret:rds!db-XXXX

# Región de AWS (la misma de la base y de los SMS)
AWS_DEFAULT_REGION=us-east-1

# Avisos por SMS al guardia (Amazon SNS). APAGADO: cada SMS a Ecuador cuesta $0,31 y
# una cuenta nueva solo permite $1 al mes (unos 3 SMS). Para encenderlo, quita el # de
# ZENTRY_NOTIFICACION. Para mandar solo uno de prueba: python manage.py probar_sms
ZENTRY_SMS_DESTINOS=09XXXXXXXX
# ZENTRY_NOTIFICACION=alertas.adaptadores.NotificacionSMS
