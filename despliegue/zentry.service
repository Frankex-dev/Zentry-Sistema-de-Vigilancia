# Servicio de systemd: Zentry con gunicorn, solo escuchando en la propia máquina (Caddy hace de puerta HTTPS)
[Unit]
Description=Zentry (Django + gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/zentry/Zentry
ExecStart=/opt/zentry/.venv/bin/gunicorn Zentry.wsgi:application --bind 127.0.0.1:8000 --workers 2 --threads 4 --timeout 60
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
